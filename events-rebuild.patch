-<script>
-let currentShiftId = null;
-let shiftsData = [];
-
-// Initialize
-document.addEventListener('DOMContentLoaded', function() {
-    refreshShifts();
-});
-
-function updateShiftDefaults() {
-    const eventSelect = document.getElementById('eventSelect');
-    const option = eventSelect.options[eventSelect.selectedIndex];
-    
-    if (option.value) {
-        const eventDate = new Date(option.getAttribute('data-date'));
-        const eventLocation = option.getAttribute('data-location');
-        
-        // Set start time to event time
-        document.getElementById('shiftStartTime').value = formatDateTimeLocal(eventDate);
-        
-        // Set end time to 1 hour after start
-        const endTime = new Date(eventDate);
-        endTime.setHours(endTime.getHours() + 1);
-        document.getElementById('shiftEndTime').value = formatDateTimeLocal(endTime);
-        
-        // Set location to event location
-        if (eventLocation) {
-            document.getElementById('shiftLocation').value = eventLocation;
-        }
-    }
-}
-
-function formatDateTimeLocal(date) {
-    const year = date.getFullYear();
-    const month = String(date.getMonth() + 1).padStart(2, '0');
-    const day = String(date.getDate()).padStart(2, '0');
-    const hours = String(date.getHours()).padStart(2, '0');
-    const minutes = String(date.getMinutes()).padStart(2, '0');
-    return `${year}-${month}-${day}T${hours}:${minutes}`;
-}
-
-function showModal(modalId) {
-    document.getElementById(modalId).style.display = 'block';
-}
-
-function hideModal(modalId) {
-    document.getElementById(modalId).style.display = 'none';
-}
-
-async function refreshShifts() {
-    try {
-        const response = await fetch('/api/shifts');
-        shiftsData = await response.json();
-        renderShifts();
-        updateStats();
-    } catch (error) {
-        console.error('Error fetching shifts:', error);
-        alert('Failed to load shifts');
-    }
-}
-
-function filterShifts() {
-    renderShifts();
-}
-
-function renderShifts() {
-    const eventFilterValue = document.getElementById('eventFilter').value;
-    const statusFilterValue = document.getElementById('statusFilter').value;
-    
-    let filtered = shiftsData;
-    
-    if (eventFilterValue) {
-        filtered = filtered.filter(s => s.event_id == eventFilterValue);
-    }
-    
-    if (statusFilterValue === 'open') {
-        filtered = filtered.filter(s => s.is_open);
-    } else if (statusFilterValue === 'full') {
-        filtered = filtered.filter(s => s.assignments_count >= s.positions_needed);
-    }
-    
-    const container = document.getElementById('shiftsContainer');
-    
-    if (filtered.length === 0) {
-        container.innerHTML = `
-            <div class="empty-state">
-                <i class="fas fa-calendar-times"></i>
-                <p>No shifts found</p>
-            </div>
-        `;
-        return;
-    }
-    
-    container.innerHTML = filtered.map(shift => `
-        <div class="shift-card">
-            <div class="shift-header">
-                <div>
-                    <h3 class="shift-title">${escapeHtml(shift.title)}</h3>
-                    <div class="shift-meta">
-                        <div class="shift-meta-item">
-                            <i class="fas fa-calendar"></i>
-                            ${new Date(shift.shift_date).toLocaleDateString('en-US', {month: 'short', day: 'numeric'})}
-                        </div>
-                        <div class="shift-meta-item">
-                            <i class="fas fa-clock"></i>
-                            ${new Date(shift.shift_date).toLocaleTimeString('en-US', {hour: '2-digit', minute: '2-digit'})} - ${new Date(shift.shift_end_date).toLocaleTimeString('en-US', {hour: '2-digit', minute: '2-digit'})}
-                        </div>
-                        <div class="shift-meta-item">
-                            <i class="fas fa-map-marker-alt"></i>
-                            ${escapeHtml(shift.location || shift.event_title || 'TBD')}
-                        </div>
-                    </div>
-                </div>
-                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
-                    ${shift.role ? `<span class="shift-badge badge-role">${escapeHtml(shift.role)}</span>` : ''}
-                    ${shift.is_open ? '<span class="shift-badge badge-open">Open to Claim</span>' : ''}
-                    ${shift.assignments_count >= shift.positions_needed ? '<span class="shift-badge badge-full">Full</span>' : ''}
-                </div>
-            </div>
-            
-            <div class="shift-positions">
-                <i class="fas fa-users"></i>
-                <span>${shift.assignments_count}/${shift.positions_needed} assigned</span>
-            </div>
-            
-            ${shift.description ? `<p style="color: #6b7280; font-size: 0.9rem; margin: 0.5rem 0 0 0;">${escapeHtml(shift.description)}</p>` : ''}
-            
-            <div class="assignments-list">
-                <strong style="color: var(--dark); font-size: 0.9rem;">Assignments (${shift.assignments.length})</strong>
-                ${shift.assignments.length > 0 ? shift.assignments.map(a => `
-                    <div class="assignment-item ${a.status}">
-                        <div>
-                            <div class="assignment-user">${escapeHtml(a.username)}</div>
-                            <div style="font-size: 0.8rem; color: #6b7280;">Assigned by ${escapeHtml(a.assigned_by)} • ${new Date(a.assigned_at).toLocaleDateString()}</div>
-                        </div>
-                        <div style="display: flex; align-items: center; gap: 0.5rem;">
-                            <span class="assignment-status status-${a.status}">${a.status}</span>
-                            <button onclick="removeAssignment(${a.id})" class="btn" style="padding: 0.3rem 0.6rem; font-size: 0.8rem; background: #fee2e2; color: #991b1b; border: none;">
-                                <i class="fas fa-times"></i>
-                            </button>
-                        </div>
-                    </div>
-                `).join('') : `
-                    <div style="padding: 1rem; text-align: center; color: #9ca3af; font-size: 0.9rem;">
-                        No assignments yet
-                    </div>
-                `}
-            </div>
-            
-            <div class="shift-actions" style="margin-top: 1rem;">
-                <button onclick="openAssignModal(${shift.id})" class="btn btn-primary"><i class="fas fa-user-plus"></i> Assign Crew</button>
-                <button onclick="openEditModal(${shift.id})" class="btn btn-primary"><i class="fas fa-edit"></i> Edit</button>
-            </div>
-        </div>
-    `).join('');
-}
-
-function updateStats() {
-    const totalShifts = shiftsData.length;
-    const openShifts = shiftsData.filter(s => s.is_open).length;
-    const pendingAssignments = shiftsData.reduce((sum, s) => sum + s.assignments.filter(a => a.status === 'pending').length, 0);
-    const confirmedAssignments = shiftsData.reduce((sum, s) => sum + s.assignments.filter(a => a.status === 'confirmed').length, 0);
-    
-    document.getElementById('totalShifts').textContent = totalShifts;
-    document.getElementById('openShifts').textContent = openShifts;
-    document.getElementById('pendingAssignments').textContent = pendingAssignments;
-    document.getElementById('confirmedAssignments').textContent = confirmedAssignments;
-}
-
-function openAssignModal(shiftId) {
-    currentShiftId = shiftId;
-    showModal('assignCrewModal');
-}
-
-async function assignCrewMember() {
-    const userId = document.getElementById('userSelect').value;
-    const notes = document.getElementById('assignmentNotes').value;
-    
-    if (!userId) {
-        alert('Please select a crew member');
-        return;
-    }
-    
-    try {
-        const response = await fetch(`/shifts/${currentShiftId}/assign`, {
-            method: 'POST',
-            headers: { 'Content-Type': 'application/json' },
-            body: JSON.stringify({ user_id: userId, notes: notes })
-        });
-        
-        if (response.ok) {
-            hideModal('assignCrewModal');
-            document.getElementById('userSelect').value = '';
-            document.getElementById('assignmentNotes').value = '';
-            refreshShifts();
-            alert('Crew member assigned successfully!');
-        } else {
-            const error = await response.json();
-            alert('Error: ' + (error.error || 'Failed to assign crew'));
-        }
-    } catch (error) {
-        console.error('Error:', error);
-        alert('Error assigning crew member');
-    }
-}
-
-async function removeAssignment(assignmentId) {
-    if (!confirm('Remove this assignment?')) return;
-    
-    try {
-        const response = await fetch(`/shifts/assignment/${assignmentId}`, {
-            method: 'DELETE'
-        });
-        
-        if (response.ok) {
-            refreshShifts();
-            alert('Assignment removed');
-        } else {
-            alert('Failed to remove assignment');
-        }
-    } catch (error) {
-        console.error('Error:', error);
-        alert('Error removing assignment');
-    }
-}
-
-async function createShift() {
-    const eventId = document.getElementById('eventSelect').value;
-    if (!eventId) {
-        alert('Please select an event');
-        return;
-    }
-    
-    const data = {
-        event_id: parseInt(eventId),
-        title: document.getElementById('shiftTitle').value,
-        role: document.getElementById('shiftRole').value,
-        shift_date: document.getElementById('shiftStartTime').value.replace('T', ' '),
-        shift_end_date: document.getElementById('shiftEndTime').value.replace('T', ' '),
-        location: document.getElementById('shiftLocation').value,
-        positions_needed: parseInt(document.getElementById('positionsNeeded').value),
-        description: document.getElementById('shiftDescription').value,
-        is_open: document.getElementById('isOpen').checked
-    };
-    
-    try {
-        const response = await fetch('/shifts/add', {
-            method: 'POST',
-            headers: { 'Content-Type': 'application/json' },
-            body: JSON.stringify(data)
-        });
-        
-        if (response.ok) {
-            hideModal('addShiftModal');
-            document.getElementById('addShiftForm').reset();
-            refreshShifts();
-            alert('Shift created successfully!');
-        } else {
-            const error = await response.json();
-            alert('Error: ' + (error.error || 'Failed to create shift'));
-        }
-    } catch (error) {
-        console.error('Error:', error);
-        alert('Error creating shift');
-    }
-}
-
-function openEditModal(shiftId) {
-    const shift = shiftsData.find(s => s.id === shiftId);
-    if (!shift) return;
-    
-    currentShiftId = shiftId;
-    document.getElementById('editShiftTitle').value = shift.title;
-    document.getElementById('editShiftRole').value = shift.role || '';
-    document.getElementById('editShiftStartTime').value = new Date(shift.shift_date).toISOString().slice(0, 16);
-    document.getElementById('editShiftEndTime').value = new Date(shift.shift_end_date).toISOString().slice(0, 16);
-    document.getElementById('editShiftLocation').value = shift.location || '';
-    document.getElementById('editPositionsNeeded').value = shift.positions_needed;
-    document.getElementById('editShiftDescription').value = shift.description || '';
-    document.getElementById('editIsOpen').checked = shift.is_open;
-    
-    showModal('editShiftModal');
-}
-
-async function updateShift() {
-    const data = {
-        title: document.getElementById('editShiftTitle').value,
-        role: document.getElementById('editShiftRole').value,
-        shift_date: document.getElementById('editShiftStartTime').value.replace('T', ' '),
-        shift_end_date: document.getElementById('editShiftEndTime').value.replace('T', ' '),
-        location: document.getElementById('editShiftLocation').value,
-        positions_needed: parseInt(document.getElementById('editPositionsNeeded').value),
-        description: document.getElementById('editShiftDescription').value,
-        is_open: document.getElementById('editIsOpen').checked
-    };
-    
-    try {
-        const response = await fetch(`/shifts/${currentShiftId}/edit`, {
-            method: 'PUT',
-            headers: { 'Content-Type': 'application/json' },
-            body: JSON.stringify(data)
-        });
-        
-        if (response.ok) {
-            hideModal('editShiftModal');
-            refreshShifts();
-            alert('Shift updated successfully!');
-        } else {
-            const error = await response.json();
-            alert('Error: ' + (error.error || 'Failed to update shift'));
-        }
-    } catch (error) {
-        console.error('Error:', error);
-        alert('Error updating shift');
-    }
-}
-
-async function deleteCurrentShift() {
-    if (!confirm('Delete this shift? This cannot be undone.')) return;
-    
-    try {
-        const response = await fetch(`/shifts/${currentShiftId}`, {
-            method: 'DELETE'
-        });
-        
-        if (response.ok) {
-            hideModal('editShiftModal');
-            refreshShifts();
-            alert('Shift deleted');
-        } else {
-            alert('Failed to delete shift');
-        }
-    } catch (error) {
-        console.error('Error:', error);
-        alert('Error deleting shift');
-    }
-}
-
-function escapeHtml(text) {
-    const div = document.createElement('div');
-    div.textContent = text;
-    return div.innerHTML;
-}
-</script>
