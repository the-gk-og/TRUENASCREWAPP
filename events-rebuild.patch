+
+/* ---------- calendar ---------- */
+.sw-cal-controls { display:flex; gap:.75rem; flex-wrap:wrap; align-items:center; margin-bottom:1rem; }
+.sw-cal-controls select { padding:.5rem .7rem; border:1px solid var(--border-input); border-radius:8px; background:var(--bg-input); color:var(--text-primary); }
+.sw-cal-controls label.sw-check { display:inline-flex; align-items:center; gap:.4rem; font-size:.9rem; color:var(--text-primary); cursor:pointer; }
